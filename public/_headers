/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/images/*
  Cache-Control: public, max-age=604800

/styles.css
  Cache-Control: public, max-age=86400

/main.js
  Cache-Control: public, max-age=86400

/api/*
  ! Cache-Control
  Cache-Control: no-store

/*.txt
  Cache-Control: public, max-age=3600
